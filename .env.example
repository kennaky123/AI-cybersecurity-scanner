# ==============================================================================
# AI CYBERSECURITY SCANNER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy file này thành .env trên máy của bạn và điền các API key tương ứng.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI EXPLAINER (Google Gemini API - Khuyến nghị)
# Dùng cho tính năng giải thích mã độc / phishing bằng AI và Security Tutor
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. MALWARE DYNAMIC SANDBOX (Hybrid Analysis / Falcon Sandbox API)
# Dùng để kích hoạt tính năng nổ sandbox phân tích hành vi độc hại
# Lấy miễn phí tại: https://www.hybrid-analysis.com/ (Profile -> API Key)
# ------------------------------------------------------------------------------
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here

# ------------------------------------------------------------------------------
# 3. THREAT INTELLIGENCE APIS (Tùy chọn)
# MalwareBazaar: https://bazaar.abuse.ch/ (Tra cứu mẫu mã độc quốc tế abuse.ch)
# VirusTotal:    https://www.virustotal.com/gui/user/<username>/apikey
# ------------------------------------------------------------------------------
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# ------------------------------------------------------------------------------
# 4. SERVER & SANDBOX CONFIGURATION
# ------------------------------------------------------------------------------
SANDBOX_ENABLED=true
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PORT=8000
HOST=0.0.0.0
